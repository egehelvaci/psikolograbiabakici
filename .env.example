# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env.local` sürüm kontrolüne girmez.

# Google Analytics 4 ölçüm kimliği (G-XXXXXXXXXX).
# Boş bırakılırsa GA4 betiği hiç yüklenmez; site GA4 olmadan da çalışır.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console doğrulaması için HTML etiketi yöntemi kullanılacaksa
# doğrulama kodu buraya girilir. Tercih edilen yöntem DNS TXT kaydıdır.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
